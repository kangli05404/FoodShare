<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="@color/foodshare_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/foodshare_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageOrder"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="Order item image"
                android:scaleType="centerCrop"
                android:src="@drawable/magic_box_01" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lunch Box"
                    android:textColor="@color/foodshare_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Order #ABC123"
                    android:textColor="@color/foodshare_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textOrderStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="UPCOMING"
                    android:textColor="@color/foodshare_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textOrderQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Quantity: 1"
            android:textColor="@color/foodshare_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textOrderTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Total: RM 0.00"
            android:textColor="@color/foodshare_green"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textPickupTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pickup: 2:30 PM - 2:50 PM"
            android:textColor="@color/foodshare_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Payment: Completed"
            android:textColor="@color/foodshare_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textOrderTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="30 Aug 2026, 01:30 AM"
            android:textColor="@color/foodshare_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOrderAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="50dp"
            android:text="Mark Ready"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/foodshare_green"
            app:cornerRadius="14dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>