<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/consumer_milky">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="78dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/bg_back_button"
                android:contentDescription="@string/action_back"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back_dark"
                app:tint="@color/foodshare_text" />

            <TextView
                android:id="@+id/textToolbarTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:text="Listing Details"
                android:textColor="@color/foodshare_text"
                android:textSize="22sp"
                android:textStyle="bold" />

        </FrameLayout>

        <ImageView
            android:id="@+id/imageListingDetail"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="fitCenter"
            android:background="@color/foodshare_surface"
            android:contentDescription="Food image"
            android:src="@drawable/magic_box_01" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="92dp">

            <TextView
                android:id="@+id/textFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Food Name"
                android:textColor="@color/foodshare_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRestaurantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="FoodShare Partner"
                android:textColor="@color/foodshare_dark_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRestaurantLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="📍 Location unavailable"
                android:textColor="@color/foodshare_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="RM 0.00"
                android:textColor="@color/consumer_lime"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Available: 0"
                android:textColor="@color/foodshare_text_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/foodshare_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Description"
                android:textColor="@color/foodshare_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Description goes here"
                android:textColor="@color/foodshare_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Collection Time"
                android:textColor="@color/foodshare_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDiscountPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Collect between 10:00 - 18:00"
                android:textColor="@color/foodshare_text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAddToCart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:text="Proceed to Checkout"
        android:textColor="@color/foodshare_surface"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/consumer_lime"
        app:cornerRadius="16dp" />

</FrameLayout>
