<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardListing"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/foodshare_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/consumer_lime_light"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================================================= -->
        <!-- Image + Basic Information -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Magic Box Image -->

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp">

                <ImageView
                    android:id="@+id/imageListing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Magic Box image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_food_placeholder" />

            </FrameLayout>

            <!-- Basic Information -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <!-- Food Name -->

                <TextView
                    android:id="@+id/textFoodName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Food Name"
                    android:textColor="@color/foodshare_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Category -->

                <TextView
                    android:id="@+id/textCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Category"
                    android:textColor="@color/foodshare_text_secondary"
                    android:textSize="13sp" />

                <!-- Discounted price + original price -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 0.00"
                        android:textColor="@color/foodshare_dark_green"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="RM 0.00"
                        android:textColor="@color/foodshare_text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textDiscountPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_discount_badge"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="20% off"
                        android:textColor="@color/foodshare_dark_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Quantity -->

                <TextView
                    android:id="@+id/textQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Available: 0"
                    android:textColor="@color/foodshare_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- Discount Deadline -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textDiscountPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Collect by: 18:00"
            android:textColor="@color/foodshare_dark_green"
            android:textSize="14sp" />

        <!-- ================================================= -->
        <!-- Divider -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/foodshare_outline" />

        <!-- ================================================= -->
        <!-- Add to Cart Button -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddToCart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Add to Cart"
            android:textColor="@color/foodshare_surface"
            android:textSize="14sp"
            app:backgroundTint="@color/consumer_lime"
            app:cornerRadius="12dp" />

    </LinearLayout>

        <TextView
            android:id="@+id/textTimeRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_time_remaining"
            android:drawableStart="@drawable/ic_time_remaining"
            android:drawablePadding="3dp"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
