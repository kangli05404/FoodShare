<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/foodshare_cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Orders"
            android:textColor="@color/foodshare_dark_green"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Manage customer pickup orders"
            android:textColor="@color/foodshare_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tabUpcoming"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:minWidth="95dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Upcoming"
                android:textColor="@color/foodshare_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabReady"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:minWidth="85dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Ready"
                android:textColor="@color/foodshare_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tabCompleted"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:minWidth="105dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Completed"
                android:textColor="@color/foodshare_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tabCanceled"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:minWidth="100dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Canceled"
                android:textColor="@color/foodshare_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/foodshare_outline" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/textEmptyOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="No upcoming orders."
            android:textColor="@color/foodshare_text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>