<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="@color/foodshare_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/foodshare_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================================================= -->
        <!-- Image + Basic Information -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Magic Box Image -->

            <ImageView
                android:id="@+id/imageListing"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="Magic Box image"
                android:scaleType="centerCrop"
                android:src="@drawable/magic_box_01" />

            <!-- Basic Information -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <!-- Food Name -->

                <TextView
                    android:id="@+id/textFoodName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Food Name"
                    android:textColor="@color/foodshare_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Price -->

                <TextView
                    android:id="@+id/textPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="RM 0.00"
                    android:textColor="@color/foodshare_green"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Quantity -->

                <TextView
                    android:id="@+id/textQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Available: 0 / 0"
                    android:textColor="@color/foodshare_text_secondary"
                    android:textSize="14sp" />

                <!-- Status -->

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_listing_status"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="ACTIVE"
                    android:textColor="@color/foodshare_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- Description -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Description"
            android:textColor="@color/foodshare_text"
            android:textSize="14sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- ================================================= -->
        <!-- Discount Period -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textDiscountPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Discount Period: 10:00 - 18:00"
            android:textColor="@color/foodshare_text_secondary"
            android:textSize="14sp" />

        <!-- ================================================= -->
        <!-- Discount Rules -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textDiscountRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Discount Rules:"
            android:textColor="@color/foodshare_text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- ================================================= -->
        <!-- Divider -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/foodshare_outline" />

        <!-- ================================================= -->
        <!-- Buttons -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Edit -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditListing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Edit"
                android:textColor="@color/foodshare_green"
                android:textSize="14sp"
                app:backgroundTint="@color/foodshare_surface"
                app:cornerRadius="12dp"
                app:strokeColor="@color/foodshare_green"
                app:strokeWidth="1dp" />

            <!-- Delete -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDeleteListing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Delete"
                android:textColor="@color/foodshare_error"
                android:textSize="14sp"
                app:backgroundTint="@color/foodshare_surface"
                app:cornerRadius="12dp"
                app:strokeColor="@color/foodshare_error"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>