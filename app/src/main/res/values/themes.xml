<resources>
    <style name="Base.Theme.FoodShare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/foodshare_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/foodshare_brown</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/foodshare_surface</item>
        <item name="colorOnSurface">@color/foodshare_text</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/foodshare_cream</item>
    </style>

    <style name="Theme.FoodShare" parent="Base.Theme.FoodShare" />

    <style name="Widget.FoodShare.AuthTextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/foodshare_surface</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="VendorBottomNavigationActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/consumer_lime_light</item>
    </style>
</resources>
